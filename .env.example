# Mistral AI API Key (Get yours from https://console.mistral.ai/)
MISTRAL_API_KEY="your_mistral_api_key_here"

# Whisper Model (Options: tiny, base, small, medium, large)
WHISPER_MODEL="base"

# Mistral LLM Model (Options: open-mistral-nemo, open-mistral-7b, mistral-small-latest)
MISTRAL_MODEL="open-mistral-nemo"

